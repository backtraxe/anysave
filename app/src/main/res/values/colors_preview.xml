<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      60/30/10 palette for the preview panel (M23: teal + coral + cream).
      Cream canvas keeps the teal 10% accent calm; coral is reserved for
      selection/attention, matching the launcher icon's spark.
    -->
    <color name="preview_canvas">#F6F4EF</color>
    <color name="preview_surface">#FFFFFF</color>
    <color name="preview_placeholder">#EDE8DE</color>
    <color name="preview_placeholder_icon">#8C8579</color>
    <color name="preview_divider">#14000000</color>
    <color name="preview_text_secondary">#5F5A50</color>

    <!-- Warm near-black scrims for chrome that sits on arbitrary cover art. -->
    <color name="preview_media_scrim">#B31C1714</color>
    <color name="preview_media_scrim_soft">#731C1714</color>
    <color name="preview_scrim">#F214100D</color>
    <color name="preview_glass">#26FFFFFF</color>
    <color name="preview_glass_border">#1FFFFFFF</color>
    <color name="preview_on_dark_muted">#99FFFFFF</color>

    <!-- Brand ramp: tinted teal fills for filters/avatars/buttons. -->
    <color name="preview_brand_tint">#1A0F766E</color>
    <color name="preview_brand_tint_soft">#0D0F766E</color>
    <color name="preview_brand_tint_border">#330F766E</color>

    <!-- Tinted shadows keep depth warm instead of a gray haze. -->
    <color name="preview_shadow_tint">#33958B79</color>

    <!-- M2 save flow: progress track, pressed brand, danger. -->
    <color name="preview_progress_track">#EAE4D8</color>
    <color name="preview_brand_pressed">#0B5F58</color>
    <color name="preview_danger">#A8402C</color>

    <!-- Selection accent echoes the icon's coral spark. -->
    <color name="preview_accent">#F9735B</color>
    <color name="preview_accent_pressed">#E05A44</color>
</resources>
