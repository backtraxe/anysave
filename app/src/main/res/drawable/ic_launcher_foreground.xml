<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal download mark: one arrow + one tray line. Cream on brand teal. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shaft + head share the same stroke weight and round caps. -->
    <path
        android:pathData="M54,30 V56 M40,44 L54,58 L68,44"
        android:strokeColor="#FFF6E9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="10" />

    <!-- Tray: a single rounded line instead of a box/glyph. -->
    <path
        android:pathData="M36,74 H72"
        android:strokeColor="#FFF6E9"
        android:strokeLineCap="round"
        android:strokeWidth="10" />
</vector>
