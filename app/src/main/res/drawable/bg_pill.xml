<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/preview_brand_tint" />
            <stroke
                android:width="1dp"
                android:color="@color/preview_brand_tint_border" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/preview_divider" />
            <stroke
                android:width="1dp"
                android:color="@color/preview_divider" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/preview_divider" />
        </shape>
    </item>
</selector>
