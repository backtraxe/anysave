<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: warm brand gradient (top-left light to
     bottom-right deep) so the white save glyph stays crisp on every mask. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FF5A36"
        android:endColor="#DE4527"
        android:startColor="#FF8A5F"
        android:type="linear" />
</shape>
