<?xml version="1.0" encoding="utf-8"?>
<!--
  M1 preview panel, inflated full-screen into @id/previewRoot by ui.PreviewPanel.

  Layout hierarchy (top to bottom):
    top bar    back to page + "Preview" + item count
    header     author, source domain, 3-line caption
    filters    All / Images / Videos segmented pills
    grid       3-column 3:4 cards (thumbnails, duration, selection chips)
    footer     thumb-zone selection summary + select all / clear
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/previewPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preview_canvas"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/previewPanelContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/panelTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/panelBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/preview_back"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/text_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/panelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/preview_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/panelSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/preview_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/preview_divider" />

        <!-- Post header: author + caption + source attribution -->
        <LinearLayout
            android:id="@+id/postHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/postAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="@color/brand"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/postAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/postSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/preview_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/postDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textColor="@color/preview_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Filters -->
        <HorizontalScrollView
            android:id="@+id/filterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/preview_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/filterImages"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/preview_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/filterVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/preview_text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Grid + empty state share the flexible middle area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mediaGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_empty_icon_circle"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:id="@+id/emptyIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_photo_library"
                        android:tint="@color/brand" />
                </FrameLayout>

                <TextView
                    android:id="@+id/emptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/emptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/preview_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/emptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_footer_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="112dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/brand"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Footer lives in the thumb zone. Idle shows the selection
             summary + save CTA; Running swaps the summary for a determinate
             progress edge; Finished swaps in the result summary and actions. -->
        <FrameLayout
            android:id="@+id/panelFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/preview_surface"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/preview_shadow_tint"
            android:outlineSpotShadowColor="@color/preview_shadow_tint">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/preview_divider" />

            <LinearLayout
                android:id="@+id/footerBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <ProgressBar
                    android:id="@+id/saveProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_save"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/footerCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/saveRunningText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/saveFinishedSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/saveFinishedFailed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/preview_danger"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/footerSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_text_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/preview_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/saveButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_save_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:minWidth="96dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/footerFinishedActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/saveDoneButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_text_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/preview_done"
                        android:textColor="@color/preview_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/saveOpenAlbumButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_save_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="104dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/preview_open_album"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
